#!/bin/bash --login
module purge
module load SciPy-bundle/2025.07-gfbf-2025b

# Lambda values rescaled by N^2 = 2.5e7 (N=5000) since residual is now in density units

python simulation.py \
  --data_path ../simulation/data/mv_sim_seed0.npz \
  --outdir ./data_lambda_0 \
  --max_steps 1000 \
  --num_particles 5000 \
  --obs_num_particles 50000 \
  --grid_nx 64 \
  --grid_nv 64 \
  --v_mesh_margin 0.5 \
  --nudge_iters 5 \
  --init_mode maxwellian \
  --obs_keep_prob 1.0 \
  --obs_noise_x_std 0.0 \
  --obs_noise_v_std 0.0 \
  --lambda_nudge 0

